<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards for Debug Suite">
    <description>WordPress.org compliant coding standards for WordPress plugins.</description>

    <!-- What to scan -->
    <file>.</file>

    <!-- What to exclude -->
    <exclude-pattern>*/.git/*</exclude-pattern>
    <exclude-pattern>*/.githooks/*</exclude-pattern>
    <exclude-pattern>*/.make/*</exclude-pattern>
    <exclude-pattern>*.asset.php</exclude-pattern>
    <exclude-pattern>assets/*</exclude-pattern>
    <exclude-pattern>src/*</exclude-pattern>
    <exclude-pattern>lib/*</exclude-pattern>
    <exclude-pattern>dist/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>dependencies/*</exclude-pattern>
    <exclude-pattern>*.twig</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>
    <exclude-pattern>*.scss</exclude-pattern>
    <exclude-pattern>languages/*</exclude-pattern>

    <!-- How to scan -->
    <arg name="colors"/>
    <arg name="basepath" value="./"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <!-- Memory and error handling -->
    <ini name="memory_limit" value="512M"/>
    <arg name="error-severity" value="1"/>
    <arg name="warning-severity" value="6"/>


    <!-- WordPress Core Standards -->
    <rule ref="WordPress-Core">
        <!-- Exclude inline comment punctuation rule -->
        <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
        <exclude name="Generic.Functions.CallTimePassByReference"/>
    </rule>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>

    <!-- WordPress.org CRITICAL Requirements -->

    <!-- Prefix all globals (REQUIRED) -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="debug_suite"/>
                <element value="DebugSuite"/>
                <element value="DEBUG_SUITE"/>
            </property>
        </properties>
    </rule>

    <!-- Enforce short array syntax -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax" />

    <!-- Security - Output escaping (CRITICAL) -->
    <rule ref="WordPress.Security.EscapeOutput"/>

    <!-- Security - Database queries (CRITICAL) -->
    <rule ref="WordPress.DB.PreparedSQL"/>

    <!-- Security - Input validation (CRITICAL) -->
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>

    <!-- Security - Nonce verification (CRITICAL) -->
    <rule ref="WordPress.Security.NonceVerification"/>

    <!-- I18n with text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="debug-suite"/>
            </property>
        </properties>
    </rule>

    <!-- Performance rules -->
    <rule ref="WordPress.WP.AlternativeFunctions"/>
    <rule ref="WordPress.DB.SlowDBQuery"/>

    <!-- WordPress.org specific customizations -->

    <!-- Make security violations errors -->
    <rule ref="WordPress.Security.EscapeOutput.OutputNotEscaped">
        <type>error</type>
        <message>All output must be escaped. Use esc_html(), esc_attr(), wp_kses() or similar.</message>
    </rule>

    <rule ref="WordPress.DB.PreparedSQL.NotPrepared">
        <type>error</type>
        <message>Use $wpdb->prepare() for all database queries.</message>
    </rule>

    <rule ref="WordPress.Security.ValidatedSanitizedInput.InputNotValidated">
        <type>error</type>
    </rule>

    <rule ref="WordPress.Security.ValidatedSanitizedInput.InputNotSanitized">
        <type>error</type>
    </rule>

    <!-- Strict comparisons for security -->
    <rule ref="WordPress.PHP.StrictInArray">
        <type>error</type>
    </rule>

    <rule ref="Universal.Operators.StrictComparisons">
        <type>error</type>
    </rule>

    <!-- Relaxed rules for debug plugins -->

    <!-- Allow development functions in debug plugins -->
    <rule ref="WordPress.PHP.DevelopmentFunctions">
        <type>warning</type>
        <exclude name="WordPress.PHP.DevelopmentFunctions.error_log_error_log"/>
    </rule>

    <!-- Allow some flexibility in formatting -->
    <rule ref="WordPress.Arrays.MultipleStatementAlignment.DoubleArrowNotAligned">
        <severity>0</severity>
    </rule>

    <!-- Prevent overriding WordPress global variables -->
    <rule ref="WordPress.WP.GlobalVariablesOverride">
        <severity>0</severity>
    </rule>

    <rule ref="WordPress.PHP.YodaConditions.NotYoda">
        <severity>0</severity>
    </rule>

    <!-- Relaxed documentation for internal code -->
    <rule ref="Squiz.Commenting">
        <severity>0</severity>
    </rule>


    <rule ref="WordPress.Files.FileName">
        <severity>0</severity>
    </rule>

    <!-- Allow short array syntax -->
    <rule ref="Universal.Arrays.DisallowShortArraySyntax">
        <severity>0</severity>
    </rule>

    <!-- Allow commented code in debug tools -->
    <rule ref="Squiz.PHP.CommentedOutCode.Found">
        <severity>0</severity>
    </rule>

</ruleset>