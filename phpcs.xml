<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards for Debug Suite">
    <description>Generally-applicable sniffs for WordPress plugins.</description>

    <!-- What to scan -->
    <file>.</file>
    <!-- What to exclude -->
    <exclude-pattern type="relative">^/\.git/*</exclude-pattern>
    <exclude-pattern type="relative">^/\.githooks/*</exclude-pattern>
    <exclude-pattern type="relative">^/\.make/*</exclude-pattern>
    <exclude-pattern type="relative">*\.asset\.php$</exclude-pattern>
    <exclude-pattern type="relative">^/assets/*</exclude-pattern>
    <exclude-pattern type="relative">^/src/*</exclude-pattern>
    <exclude-pattern type="relative">^/lib/*</exclude-pattern>
    <exclude-pattern type="relative">^/dist/*</exclude-pattern>
    <exclude-pattern type="relative">^/build/*</exclude-pattern>
    <exclude-pattern type="relative">node_modules/*</exclude-pattern>
    <exclude-pattern type="relative">^/node_modules/*</exclude-pattern>
    <!-- Exclude vendor directory and all subdirectories -->
    <exclude-pattern type="relative">^/vendor/*</exclude-pattern>
    <exclude-pattern type="relative">*/vendor/*</exclude-pattern>
    <exclude-pattern type="relative">vendor/*</exclude-pattern>
    <exclude-pattern type="relative">(^includes)(\/vendor)</exclude-pattern>
    <exclude-pattern type="relative">^/tests/*</exclude-pattern>
    <exclude-pattern type="relative">^/dependencies/*</exclude-pattern>
    <exclude-pattern type="relative">*\.twig$</exclude-pattern>
    <exclude-pattern type="relative">*\.css$</exclude-pattern>
    <exclude-pattern type="relative">*\.scss$</exclude-pattern>
    <exclude-pattern type="relative">^/languages/*</exclude-pattern>

    <!-- How to scan -->
    <!-- Usage instructions: https://github.com/squizlabs/PHP_CodeSniffer/wiki/Usage -->
    <!-- Annotated ruleset: https://github.com/squizlabs/PHP_CodeSniffer/wiki/Annotated-ruleset.xml -->
    <arg value="sp"/>
    <!-- Show sniff and progress -->
    <arg name="basepath" value="./"/>
    <!-- Strip the file paths down to the relevant bit -->
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <!-- Enables parallel processing when available for faster results. -->
    
    <!-- Add memory limit and error handling -->
    <ini name="memory_limit" value="512M"/>
    <arg name="error-severity" value="1"/>
    <arg name="warning-severity" value="6"/>

    <!-- Rules: WordPress Coding Standards -->
    <config name="installed_paths" value="vendor/wp-coding-standards/wpcs,vendor/phpcompatibility/php-compatibility,vendor/phpcsstandards/phpcsutils,vendor/phpcsstandards/phpcsextra"/>

    <rule ref="WordPress">
        <!-- Exclude problematic rules -->
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
        <!-- Exclude inline comment punctuation rule -->
        <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
        <!-- Exclude missing @package tag in file comment -->
        <exclude name="WordPress.Commenting.FileComment.MissingPackageTag"/>
        <!-- Exclude deprecated sniff -->
        <exclude name="Generic.Functions.CallTimePassByReference"/>
    </rule>
    
    <!-- I18n rule with text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="debug-suite"/>
            </property>
        </properties>
    </rule>

    <!-- Rules: PHPCompatibility -->
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibility"/>

    <!-- Rules: Custom - Use long array syntax for WordPress compatibility -->
    <rule ref="Universal.Arrays.DisallowShortArraySyntax"/>

    <rule ref="WordPress.WhiteSpace.ControlStructureSpacing">
        <properties>
            <property name="blank_line_check" value="true"/>
        </properties>
    </rule>

    <rule ref="Squiz.Commenting">
        <severity>0</severity>
    </rule>
    <rule ref="PEAR.Functions.FunctionCallSignature.MultipleArguments">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.Commenting.DocComment.SpacingBeforeTags">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.Files.FileName">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.PHP.DevelopmentFunctions">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.Arrays.MultipleStatementAlignment.DoubleArrowNotAligned">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.Formatting.MultipleStatementAlignment.NotSameWarning">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.Commenting.DocComment.MissingShort">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.PHP.YodaConditions.NotYoda">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.Functions.OpeningFunctionBraceKernighanRitchie.ContentAfterBrace">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.WhiteSpace.ControlStructureSpacing.NoSpaceAfterCloseParenthesis">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.Arrays.ArrayDeclarationSpacing.AssociativeArrayFound">
        <type>warning</type>
    </rule>
    <rule ref="WordPress.DB.DirectDatabaseQuery.NoCaching">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.PHP.StrictInArray.MissingTrueStrict">
        <type>error</type>
    </rule>
    <rule ref="Universal.Operators.StrictComparisons">
        <type>error</type>
    </rule>
    <rule ref="WordPress.DB.DirectDatabaseQuery.DirectQuery">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.DB.PreparedSQL.NotPrepared">
        <type>warning</type>
    </rule>
    <rule ref="WordPress.Security.EscapeOutput.OutputNotEscaped">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.PHP.DevelopmentFunctions.error_log_var_export">
        <severity>0</severity>
    </rule>
    <rule ref="Universal.Arrays.DisallowShortArraySyntax">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.PHP.CommentedOutCode.Found">
        <severity>0</severity>
    </rule>
</ruleset>
