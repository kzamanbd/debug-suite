```

### Naming Conventions (JavaScript/TypeScript)

```typescript
// ✅ Frontend naming conventions
const ComponentName = () => {};           // PascalCase for components
const myVariableName = 'value';          // camelCase for variables/functions
const handleButtonClick = () => {};      // camelCase for functions
interface MyInterface {}                 // PascalCase for interfaces
const useMyHook = () => {};             // camelCase starting with 'use' for hooks
```

### File Naming Conventions

```md
// ✅ Use kebab-case for files
src/components/log-viewer.tsx           // Components
src/hooks/use-log-entries.ts           // Hooks  
src/utils/date-helpers.ts              // Utilities
src/types/log-types.ts                 // Types
```

### Component Architecture - Consolidation Over Micro-Components

```typescript
// ✅ Prefer 2-3 substantial components (100-300 lines each)
// ✅ Group related functionality logically:

// log-viewer.tsx - Handles ALL display concerns
const LogViewer = ({ logs, loading, pagination }: LogViewerProps) => {
    // Table rendering, log details, expandable rows, formatting
};

// log-controls.tsx - Handles ALL control concerns  
const LogControls = ({ filters, onFiltersChange, actions }: LogControlsProps) => {
    // File selection, filtering, search, pagination, export, clear
};

// ❌ Avoid excessive micro-components:
// log-entry.tsx, log-table.tsx, log-file-selector.tsx, etc.
```

### UI Component Standards

#### Always Use Headless UI Components

```typescript
// ✅ Use custom Combobox for all dropdowns
import Combobox from '@/components/ui/combobox';

<Combobox
    options={[
        { value: 'option1', label: 'Option 1' },
        { value: 'option2', label: 'Option 2' }
    ]}
    value={selectedOption}
    onChange={setSelectedOption}
    placeholder="Select option..."
/>

// ❌ Never use native <select> or other dropdown libraries
```

#### Icon Usage - Lucide React Only

```typescript
// ✅ Always use Lucide React icons
import { FolderOpen, Settings, X, Check } from 'lucide-react';

<FolderOpen size={16} className="text-primary" />

// ❌ Never use inline SVG or other icon libraries
```

### Tailwind CSS v4 Standards

```typescript
// ✅ Use Tailwind CSS v4 with Oxide engine
// ✅ ALWAYS use 'primary' color as brand color
className="bg-primary text-primary-foreground hover:bg-primary/90"

// ✅ Use classNames utility for conditional classes
import { classNames } from '@/utils';

className={classNames(
    'base-classes',
    isActive && 'active-classes',
    hasError && 'error-classes'
)}

// ✅ Responsive design with breakpoints
className="w-full md:w-1/2 lg:w-1/3"
