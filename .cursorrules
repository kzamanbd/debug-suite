// ✅ Functional components with hooks
// ✅ Proper interface definitions

interface ComponentProps {
    data: LogEntry[];
    onSelect: (id: string) => void;
    isLoading?: boolean;
}

const MyComponent: React.FC<ComponentProps> = ({ data, onSelect, isLoading = false }) => {
    // Implementation
