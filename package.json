{
    "name": "debug-suite",
    "version": "1.1.3",
    "packageManager": "pnpm@10.28.1",
    "description": "WP Debug Suite is a powerful, all-in-one development toolkit designed to make WordPress debugging and inspection faster, safer, and more intuitive. Whether you're building, maintaining, or debugging WordPress sites, this suite equips you with the tools you need — all in one place.",
    "main": "index.js",
    "scripts": {
        "dev": "wp-scripts start --progress",
        "build": "wp-scripts build --progress",
        "type-check": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "make:pot": "wp i18n make-pot --domain='debug-suite' --include='assets/js,includes,templates,debug-suite.php' . --headers='{\"Report-Msgid-Bugs-To\":\"https://kzaman.me/contact/\"}' --file-comment=\"Copyright (c) $(date +'%Y') Kamruzzaman. All Rights Reserved.\" languages/debug-suite.pot",
        "version": "node bin/version.js",
        "zip": "node bin/zip.js",
        "release": "pnpm build && pnpm make:pot && npm run zip",
        "release:org": "npm run version && npm run release",
        "env:start": "wp-env start",
        "env:stop": "wp-env stop",
        "env:clean": "wp-env clean all",
        "env:test": "wp-env run tests-cli --env-cwd=wp-content/plugins/debug-suite vendor/bin/phpunit --testsuite=all",
        "env:test:unit": "wp-env run tests-cli --env-cwd=wp-content/plugins/debug-suite vendor/bin/phpunit --testsuite=unit",
        "env:test:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/debug-suite vendor/bin/phpunit --testsuite=integration"
    },
    "author": "kamruzzaman",
    "license": "MIT",
    "dependencies": {
        "@base-ui/react": "^1.3.0",
        "@monaco-editor/react": "^4.7.0",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/postcss": "^4.1.13",
        "@wordpress/api-fetch": "^7.26.0",
        "@wordpress/components": "^29.12.0",
        "@wordpress/date": "^5.26.0",
        "@wordpress/dom-ready": "^4.26.0",
        "@wordpress/element": "^6.26.0",
        "@wordpress/hooks": "^4.33.0",
        "@wordpress/i18n": "^5.26.0",
        "@wordpress/url": "^4.26.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.515.0",
        "monaco-editor": "^0.52.2",
        "php-parser": "^3.2.4",
        "react-router-dom": "^7.6.3",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.3.1",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.30.0",
        "@types/react": "^18.3.23",
        "@types/react-router-dom": "^5.3.3",
        "@wordpress/env": "^11.11.0",
        "@wordpress/scripts": "^30.19.0",
        "css-loader": "^7.1.2",
        "eslint": "^9.30.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "fs-extra": "^11.3.0",
        "globals": "^15.15.0",
        "mini-css-extract-plugin": "^2.9.4",
        "postcss": "^8.5.6",
        "postcss-loader": "^8.2.0",
        "prettier": "^3.6.2",
        "prettier-plugin-tailwindcss": "^0.6.13",
        "replace-in-file": "^8.3.0",
        "style-loader": "^4.0.0",
        "tailwindcss": "^4.1.11",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.65.0"
    }
}
